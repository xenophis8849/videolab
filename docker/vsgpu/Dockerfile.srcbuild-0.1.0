# local/vsgpu — VapourSynth + vs-mlrt(TensorRT) 视频修复运行基座
#
# 基础镜像刻意用 GPU 节点上已缓存的 nvidia/cuda:12.8.1-base-ubuntu24.04:
# 该机拉不到 Docker Hub(registry-1.docker.io 直接 EOF),而这个镜像正好是
# Ubuntu 24.04 底子,自带 Python 3.12 —— 恰是我们要锁的版本(两台宿主机都是
# Ubuntu 26.04 + Python 3.14,视频修复生态普遍还停在 3.11/3.12)。
#
# 构建必须加 --network=host:容器默认 DNS 走网关,若网关的 DNS 返回不可路由的
# fake-ip(常见于带代理/分流的网关),容器无法路由,apt 会拿不到索引。
# host 网络下用宿主机的 127.0.0.53(systemd-resolved → MagicDNS),实测 5 MB/s。
#
#   docker build --network=host -t local/vsgpu:0.1.0 .
FROM nvidia/cuda:12.8.1-base-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    LANG=C.UTF-8

# 基础编译链。TensorRT 刻意不在这一层装 —— 见下面的「CUDA 工具链」。
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential git cmake ninja-build pkg-config \
        autoconf automake libtool \
        python3 python3-dev python3-pip \
        nasm \
        ca-certificates curl xz-utils \
    && rm -rf /var/lib/apt/lists/*

# Cython 与 meson 都用 pip 版而不是发行版:VapourSynth 对两者的下限都比
# Ubuntu 24.04 提供的要新。
RUN pip install --no-cache-dir "Cython>=3.1" "meson>=1.4" setuptools wheel

# ---- zimg ----
# 必须从源码编 zimg 的 **master**,任何已发布版本都不行,Ubuntu 的
# libzimg-dev(3.0.5)更不行。
#
# VapourSynth R78 的 meson.build 只声明 `zimg >= 3.0.5`,但 vsresize.cpp 实际
# 用了 zimg_graph_builder_params::chromatic_adaptation —— 该字段截至
# release-3.0.6 都不存在,只在 master 上有。上游的版本下限写漏了,照它装会一路
# 编到 vsresize.cpp 才报 "has no member named chromatic_adaptation"。
#
# 排查时注意:字段在 **zimg.h** 里,zimg++.hpp 只是通过继承暴露它。在
# zimg++.hpp 里 grep 会得到 0,那是误导性的假阴性(本次已踩)。
#
# master 是移动靶,钉死 commit 保证可复现。
ARG ZIMG_COMMIT=f6cc75ad23db1bb9c53673c15523e6b6e960ffc6
ENV PKG_CONFIG_PATH=/usr/local/lib/pkgconfig
RUN git clone https://github.com/sekrit-twc/zimg.git /tmp/zimg \
 && cd /tmp/zimg \
 && git checkout "${ZIMG_COMMIT}" \
 && git submodule update --init --recursive \
 && ./autogen.sh \
 && ./configure --prefix=/usr/local \
 && make -j"$(nproc)" \
 && make install \
 && ldconfig \
 && rm -rf /tmp/zimg

# ---- VapourSynth ----
# R58 起已从 autotools 迁到 Meson,没有 autogen.sh/configure。
# 不要裁掉 vspipe/vsscript:整条方案靠 `vspipe | ffmpeg` 做单进程流式,
# 裁掉它们等于把这个基座的意义去掉。
#
# R78 的 meson.build **完全没有 install_headers**,`ninja install` 之后
# /usr/local/include/vapoursynth/ 根本不存在,任何外部插件都编不了
# (现象是 "VapourSynth.h: No such file or directory")。头文件在源码树的
# include/ 下是齐的,手动装进去即可 —— 不需要降级 VapourSynth 版本。
# 一并装 API3(VapourSynth.h/VSHelper.h)和 API4 两套:vs-mlrt 至今仍用 API3。
ARG VS_VERSION=R78
RUN git clone --depth 1 -b "${VS_VERSION}" \
        https://github.com/vapoursynth/vapoursynth.git /tmp/vs \
 && cd /tmp/vs \
 && meson setup build --prefix=/usr/local --buildtype=release \
 && ninja -C build \
 && ninja -C build install \
 && install -d /usr/local/include/vapoursynth \
 && install -m 0644 include/*.h /usr/local/include/vapoursynth/ \
 && ldconfig \
 && rm -rf /tmp/vs

# ---- CUDA 工具链 ----
# 基础镜像是 -base 变体,只带运行时,没有 nvcc。vstrt 的 CMakeLists 走
# FIND_PACKAGE(CUDAToolkit),没有 nvcc 会在 configure 阶段就失败。
# 刻意单独一层且放在 zimg/VapourSynth 之后:那两层各要编十几分钟,
# 加进最上面的 apt 层会让它们全部失效。
# TensorRT **必须钉在 10.x**。NVIDIA 源当前默认给 11.2.1,而 TRT 11 取消了
# trtexec 的 `dtype:layout` 写法(IOfmt 只剩 "chw"/"hwc" 等纯布局),vs-mlrt 的
# v15.16 和 master 都仍在发 `--inputIOFormats=fp32:chw`,于是 trtexec 报
# "Invalid TensorFormat fp32:chw" 并打印帮助退出。这个坑在插件加载、vsmlrt
# 导入阶段都看不出来,要跑到真正构建 engine 才暴露。
# 10.16.1.11 是 vs-mlrt 实际支持的版本线。
#
# 用 apt preferences 整族钉版,不要在 install 行上逐个写 `=版本`:那样只钉住
# 显式列出的包,apt 给它们拉依赖时仍会挑 `+cuda13.2` 变体或 11.2.1 的头文件包,
# 结果是一串 "Depends: X (= ...+cuda12.9) but ...+cuda13.2 is to be installed"
# 然后 held broken packages 退出 100。同一版本号有多个 CUDA 后缀变体,必须连
# 后缀一起匹配。
ARG TRT_VERSION=10.16.1.11-1+cuda12.9
RUN printf 'Package: libnvinfer* libnvonnxparsers*\nPin: version %s\nPin-Priority: 1001\n' \
        "${TRT_VERSION}" > /etc/apt/preferences.d/tensorrt \
 && apt-get update && apt-get install -y --no-install-recommends \
        cuda-nvcc-12-8 cuda-cudart-dev-12-8 \
        libnvinfer-dev libnvinfer-plugin-dev libnvonnxparsers-dev libnvinfer-bin \
 && rm -rf /var/lib/apt/lists/* \
 && trtexec --help 2>&1 | head -1
ENV CUDAToolkit_ROOT=/usr/local/cuda \
    PATH=/usr/local/cuda/bin:${PATH}

# ---- vs-mlrt / vstrt(TensorRT 后端)----
# 只编 vstrt 这一个后端:vsov(OpenVINO)/vsort(ONNX Runtime)/vsncnn 都需要额外
# 的大体积 SDK,而 4070 Ti 上 TensorRT 是最快的路径,其余用不上。
ARG VSMLRT_VERSION=v15.16
RUN git clone --depth 1 -b "${VSMLRT_VERSION}" \
        https://github.com/AmusementClub/vs-mlrt.git /tmp/vsmlrt \
 && cmake -S /tmp/vsmlrt/vstrt -B /tmp/vstrt-build -G Ninja \
        -D CMAKE_BUILD_TYPE=Release \
        -D VAPOURSYNTH_INCLUDE_DIRECTORY=/usr/local/include/vapoursynth \
        -D USE_NVINFER_PLUGIN=ON \
 && cmake --build /tmp/vstrt-build --config Release \
 && mkdir -p "$(python3 -c 'import sys; sys.path.insert(0,"/usr/local/lib/python3/dist-packages"); from vapoursynth._utils import get_plugin_dir; print(get_plugin_dir())')" \
 && find /tmp/vstrt-build -name 'libvstrt.so' -exec cp {} \
      "$(python3 -c 'import sys; sys.path.insert(0,"/usr/local/lib/python3/dist-packages"); from vapoursynth._utils import get_plugin_dir; print(get_plugin_dir())')/" \; \
 && install -m 0644 /tmp/vsmlrt/scripts/vsmlrt.py \
        "$(python3 -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')/vsmlrt.py" \
 && rm -rf /tmp/vsmlrt /tmp/vstrt-build

# ---- 路径修正 ----
# R78 把 libvapoursynth、vspipe、内建滤镜全部装成一个自包含的 Python 包:
#   /usr/local/lib/python3/dist-packages/vapoursynth/
# 注意是 `python3` 而不是 `python3.12` —— 这个目录**不在** CPython 的默认
# sys.path 上(默认只有 /usr/local/lib/python3.12/dist-packages 和
# /usr/lib/python3/dist-packages),所以装完之后 `import vapoursynth` 和
# `vspipe` 都是找不到的,看起来像没装成功,其实文件都在。
ENV PYTHONPATH=/usr/local/lib/python3/dist-packages
RUN ln -sf /usr/local/lib/python3/dist-packages/vapoursynth/vspipe /usr/local/bin/vspipe \
 && echo "/usr/local/lib/python3/dist-packages/vapoursynth" > /etc/ld.so.conf.d/vapoursynth.conf \
 && ldconfig \
 && python3 -m vapoursynth config \
 && VSPLUG="$(python3 -c 'from vapoursynth._utils import get_plugin_dir; print(get_plugin_dir())')" \
 && mkdir -p "$VSPLUG/vsmlrt-cuda" \
 && ln -sf /usr/bin/trtexec "$VSPLUG/vsmlrt-cuda/trtexec"

# 上面那条 `vapoursynth config` 不可省:不跑它 vspipe 会直接失败,报
# "Python executable and library path couldn't be determined"。它把解释器与
# libpython 的绝对路径写进 /root/.config/vapoursynth/vapoursynth.toml,
# VSScript 靠这份配置初始化。注意配置落在 $HOME 下 —— 换用户跑容器要重跑一次。
#
# trtexec 的符号链接同样不可省:vsmlrt.py 里 trtexec_path 是模块级常量
# (os.path.join(plugins_path, "vsmlrt-cuda", "trtexec")),按 Windows 发布包的
# 目录布局写死,没有环境变量可覆盖。Linux 上 trtexec 由 libnvinfer-bin 装到
# /usr/bin,不链过去会在真正构建 engine 时才报 FileNotFoundError —— 插件加载、
# vsmlrt 导入全都正常,所以这个坑要跑到推理那一步才暴露。

# 模型刻意不打进镜像:官方 models 包 852 MB,且会独立于代码更新。
# 运行时用 -v 挂到 /models,vsmlrt.py 通过 VSMLRT_MODEL_DIR 找它们。
ENV VSMLRT_MODEL_DIR=/models

WORKDIR /work
